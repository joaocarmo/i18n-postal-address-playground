{
  "name": "i18n-postal-address-playground",
  "description": "Playground for i18n-postal-address",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://joaocarmo.github.io/i18n-postal-address-playground",
  "author": {
    "name": "joaocarmo",
    "url": "https://joaocarmo.com"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "predeploy": "pnpm build",
    "pretty:fix": "prettier --write .",
    "deploy": "gh-pages -d build",
    "start": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "i18n-postal-address": "0.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "gh-pages": "^6.3.0",
    "prettier": "^3.8.2",
    "typescript": "^5.6.2",
    "vite": "^6.3.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
